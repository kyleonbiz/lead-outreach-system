# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (required for real authentication, database and storage) -------
# Project Settings > API. Leave all three unset to run local development mode
# (in-memory sample data, no login; refused when NODE_ENV=production).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon / publishable key. Safe for the browser: access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Server-only. Used ONLY by the public /share/[token] route to resolve share
# links. Optional: without it, share links are disabled. NEVER prefix with
# NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Upload policy (optional) -------------------------------------------------
# Per-file limit in MB (default 50). The 'documents' bucket also enforces
# 50 MB; raise both together (see supabase/migrations/*_dms_storage.sql).
DMS_MAX_FILE_SIZE_MB=50
# Files per drop/selection (default 10).
DMS_MAX_FILES_PER_BATCH=10
# Restrict the built-in allow-list to these extensions (comma-separated).
# DMS_ALLOWED_EXTENSIONS=pdf,docx,xlsx,csv,jpg,jpeg,png
# Add types as ext=mime|mime;ext=mime. Also add the MIME type to the bucket's
# allowed_mime_types or Storage will reject the upload.
# DMS_EXTRA_FILE_TYPES=rtf=application/rtf

# --- Development mode ---------------------------------------------------------
# Development mode (in-memory data, no auth) only runs when Supabase is NOT
# configured and NODE_ENV != production. Setting this to "true" forces it on in
# production (e.g. a throwaway preview). Do not enable for real client data.
# DMS_ALLOW_DEV_MODE=false
