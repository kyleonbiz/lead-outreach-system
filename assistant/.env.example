# ---- Frontend (safe to expose to the browser; these are PUBLIC values) ----
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- Server-side only (Supabase Edge Function secrets / worker env). NEVER prefix with VITE_ ----
# Set with `supabase secrets set` (see docs/DEPLOYMENT.md); listed here so setup is one pass.
ANTHROPIC_API_KEY=
ASSISTANT_DEFAULT_MODEL=            # e.g. a current Claude model id; configurable per org later
GOOGLE_OAUTH_CLIENT_ID=             # Phase 4
GOOGLE_OAUTH_CLIENT_SECRET=         # Phase 4
GOOGLE_OAUTH_REDIRECT_URI=          # https://<ref>.supabase.co/functions/v1/google-oauth-callback
TOKEN_ENCRYPTION_KEY=               # Phase 4: 32 random bytes, base64 (openssl rand -base64 32)
APP_URL=http://localhost:5173
CRON_SECRET=                        # Phase 6: shared secret for the workflow-tick scheduler (openssl rand -hex 32)
ASSISTANT_DAILY_TOKEN_LIMIT=        # optional, per-organization LLM tokens/day: digits only (default 500000, 0 = unlimited; a typo falls back to the default)
ASSISTANT_MESSAGES_PER_MINUTE=      # optional, per-user (default 12)
RESEND_API_KEY=                     # optional: enables e-mail notifications (https://resend.com)
NOTIFY_FROM_EMAIL=                  # sender on a domain you verified with the provider, e.g. "Aide <notifications@yourdomain.com>"
NOTIFY_EMAIL_PROVIDER=              # optional, only "resend" is implemented (default)
MICROSOFT_OAUTH_CLIENT_ID=          # optional: Outlook mail + calendar. Entra ID app registration (see docs/DEPLOYMENT.md)
MICROSOFT_OAUTH_CLIENT_SECRET=      # the client secret VALUE (not its id)
MICROSOFT_OAUTH_REDIRECT_URI=       # https://<ref>.supabase.co/functions/v1/microsoft-oauth-callback
MICROSOFT_OAUTH_TENANT=             # optional: common (default; work, school and personal), organizations, consumers, a tenant id or a domain

